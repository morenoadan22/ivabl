# Local umpire API config. Copy to .env and adjust; never commit .env.
PORT=3001
DB_PATH=./data/ivabl.db
APP_ORIGIN=http://localhost:5173

# Twilio notifications (leave empty to disable). SID + token are on your
# Twilio console homepage; the from-number is under Phone Numbers > Active numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp sender, e.g. whatsapp:+14155238886 (optional; enables WhatsApp notices)
TWILIO_WHATSAPP_FROM=
